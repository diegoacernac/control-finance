# Supabase → Project Settings → API. Usa la "secret key" (o la service_role en proyectos antiguos).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_valor_falso

# Token que envía el atajo de iOS. Genéralo con: openssl rand -hex 32
INGRESO_API_TOKEN=cambia-esto-por-un-token-largo

# Para el login de la web. Supabase → Project Settings → API Keys → Publishable key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_valor_falso

# Único correo que puede entrar a la web.
CORREO_PROPIETARIO=tu-correo@ejemplo.com
